{
  "name": "python-uploader-button",
  "displayName": "Python Uploader Button",
  "description": "Синяя кнопка в статус-баре и F5: запуск Python Uploader с текущим .py",
  "version": "0.1.1",
  "publisher": "Клуб Робототехники Юный Инженер",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "PythonUploader.launch",
        "title": "Python Uploader: открыть с текущим файлом",
        "icon": "$(arrow-right)"
      }
    ],
    "keybindings": [
      {
        "command": "PythonUploader.launch",
        "key": "f5",
        "when": "pythonUploader.available && editorTextFocus && editorLangId == python"
      }
    ],
    "configuration": {
      "title": "Python Uploader",
      "properties": {
        "Python_Uploader.exePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Путь к `Python_Uploader.exe`"
        }
      }
    }
  }
}
